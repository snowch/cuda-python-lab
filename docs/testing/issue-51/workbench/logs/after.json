   "source": "import math\n\nfrom numba_cuda_mlir import cuda\nfrom numba_cuda_mlir.types import float32\n\n\n@cuda.jit\ndef kernel(values, out, rows, cols):\n    scratch = cuda.shared.array(32, dtype=float32)\n    row, lane = cuda.blockIdx.x, cuda.threadIdx.x\n    if row >= rows:\n        return\n\n    local_max = -math.inf\n    for col in range(lane, cols, cuda.blockDim.x):\n        local_max = max(local_max, values[row, col])\n    scratch[lane] = local_max\n    cuda.syncthreads()\n\n    distance = cuda.blockDim.x // 2\n    while distance > 0:\n        if lane < distance:\n            scratch[lane] = max(scratch[lane], scratch[lane + distance])\n        cuda.syncthreads()\n        distance //= 2\n\n    row_max = scratch[0]\n    cuda.syncthreads()\n    local_sum = float32(0)\n    for col in range(lane, cols, cuda.blockDim.x):\n        local_sum += math.exp(values[row, col])\n    scratch[lane] = local_sum\n    cuda.syncthreads()\n\n    distance = cuda.blockDim.x // 2\n    while distance > 0:\n        if lane < distance:\n            scratch[lane] += scratch[lane + distance]\n        cuda.syncthreads()\n        distance //= 2\n\n    for col in range(lane, cols, cuda.blockDim.x):\n        out[row, col] = math.exp(values[row, col]) / scratch[0]\n\n\n# Host code\ndef main():\n    import numpy as np\n    from numba_cuda_mlir import cuda\n\n    values_host = np.array([\n        1000, 999, 1000, 997, -1000, -1002, -1001, -1000,\n        -1000, -1004,\n    ], dtype=np.float32).reshape(2, 5)\n    values = cuda.to_device(values_host)\n\n    out_host = np.zeros((2, 5), dtype=np.float32)\n    out = cuda.to_device(out_host)\n\n    kernel[2, 32](values, out, 2, 5)\n    result = out.copy_to_host()\n    print(\"out =\", result.tolist())\n    print(result.sum(axis=1))\n    print(np.isfinite(result).all())\n    return result\n\n\nif __name__ == \"__main__\":\n    actual = main()\n",
